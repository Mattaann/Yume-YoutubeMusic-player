<Window x:Class="Nocturne.Views.MiniPlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="MiniRoot" Background="#151719" RequestedTheme="Dark" Padding="18,10,18,14">
    <Grid.Resources><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/></Style></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="50"/><RowDefinition Height="22"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="NOCTURNE" FontSize="10" CharacterSpacing="160" Foreground="#9DA8AC" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4"><ToggleButton x:Name="Pin" Content="&#xE718;" FontFamily="Segoe MDL2 Assets" Click="Pin_Click" ToolTipService.ToolTip="Always on top" AutomationProperties.Name="Always on top"/><Button Content="&#xE740;" FontFamily="Segoe MDL2 Assets" Click="Restore_Click" ToolTipService.ToolTip="Open full player" AutomationProperties.Name="Open full player"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#252A2D" CornerRadius="7" Width="72" Height="72" HorizontalAlignment="Left"><Image x:Name="Cover" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock x:Name="Track" Text="Choose something to play" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Performer" Text="YouTube Music" Foreground="#9DA8AC" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20"><Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Tag="previous" Click="Control_Click" AutomationProperties.Name="Previous"/><Button x:Name="Play" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Tag="toggle" Click="Control_Click" Background="#B8D8D2" Foreground="#111213" Width="42" Height="42" CornerRadius="21" AutomationProperties.Name="Play or pause"/><Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Tag="next" Click="Control_Click" AutomationProperties.Name="Next"/></StackPanel>
    <Slider x:Name="Position" Grid.Row="3" Minimum="0" Maximum="1" ValueChanged="Position_Changed" AutomationProperties.Name="Playback position"/>
  </Grid>
</Window>
